{
  "name": "multicloud-costopti-mcp",
  "version": "1.0.0",
  "description": "Multi-cloud cost optimization MCP server for AWS, Azure, and GCP — unified FinOps visibility, rightsizing, waste detection, and savings recommendations for AI-powered IDEs and agents",
  "type": "module",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "bin": {
    "multicloud-costopti-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/lib.js",
      "types": "./dist/lib.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cost-optimization",
    "finops",
    "multicloud",
    "aws",
    "azure",
    "gcp",
    "cloud-cost",
    "rightsizing",
    "savings",
    "claude",
    "ai-agent"
  ],
  "author": "devopstronaut",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@aws-sdk/client-cost-explorer": "^3.700.0",
    "@aws-sdk/client-compute-optimizer": "^3.700.0",
    "@aws-sdk/client-ec2": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-rds": "^3.700.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.700.0",
    "@aws-sdk/client-cloudwatch": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@aws-sdk/client-pricing": "^3.700.0",
    "@aws-sdk/client-cost-and-usage-report-service": "^3.700.0",
    "@aws-sdk/client-support": "^3.700.0",
    "@azure/arm-costmanagement": "^1.0.0-beta.2",
    "@azure/arm-advisor": "^3.2.0",
    "@azure/arm-compute": "^23.3.0",
    "@azure/arm-storage": "^19.1.0",
    "@azure/arm-sql": "^10.0.0",
    "@azure/arm-containerservice": "^24.1.0",
    "@azure/arm-appservice": "^18.0.0",
    "@azure/arm-cosmosdb": "^16.4.0",
    "@azure/arm-monitor": "^7.0.0",
    "@azure/arm-consumption": "^9.2.0",
    "@azure/arm-resources": "^7.0.0",
    "@azure/identity": "^4.5.0",
    "@google-cloud/billing": "^5.1.0",
    "@google-cloud/compute": "^6.8.0",
    "@google-cloud/recommender": "^7.2.0",
    "@google-cloud/bigquery": "^8.1.0",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/container": "^6.7.0",
    "@google-cloud/resource-manager": "^6.2.0",
    "@google-cloud/monitoring": "^5.3.0",
    "@google-cloud/billing-budgets": "^6.1.0",
    "@google-cloud/asset": "^6.3.0",
    "googleapis": "^140.0.0",
    "zod": "^3.23.0",
    "winston": "^3.14.0",
    "p-limit": "^6.1.0",
    "dotenv": "^16.4.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.12.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "README.md",
    "LICENSE",
    ".env.example"
  ]
}
